#!/bin/sh
# Checks the repo against its conventions before letting a commit through.
#
# The checker type checks the code to do its job, so it looks at the working tree
# rather than at the index: what is staged is not necessarily something the
# compiler can build.
#
# Install with:
#
#   ln -sf ../../lint/hooks/pre-commit .git/hooks/pre-commit
#
# There is deliberately no way to pass arguments: a hook that can be told to skip
# a check is a hook that will be told to skip a check.
set -e
root=$(git rev-parse --show-toplevel)
cd "$root"

if command -v rust-ai-lint > /dev/null 2>&1; then
    exec rust-ai-lint
fi

# The nix build pins the nightly the checker is compiled against, so it works with
# nothing set up in the environment. A cached rebuild is immediate.
if command -v nix-build > /dev/null 2>&1; then
    for dir in lint rust-ai-lint; do
        if [ -f "$root/$dir/default.nix" ]; then
            exec "$(nix-build --no-out-link "$root/$dir")/bin/rust-ai-lint"
        fi
    done
fi

echo "pre-commit: rust-ai-lint is not on PATH and no checkout of it was found" >&2
exit 2
